---
import { Select } from '@inzumer/ui-library';

const OPTIONS = [
  { value: 'auto', label: 'Automático' },
  { value: 'light', label: 'Claro' },
  { value: 'dark', label: 'Oscuro' },
];
---

<!-- Starlight's theme picker, with the ui-library Select; Starlight still syncs it on load. -->
<starlight-theme-select>
  <Select id="theme-select" aria-label="Tema" inputSize="sm" defaultValue="auto">
    {OPTIONS.map(({ value, label }) => (
      <option value={value}>{label}</option>
    ))}
  </Select>
</starlight-theme-select>

<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  type Theme = 'auto' | 'dark' | 'light';

  const STORAGE_KEY = 'starlight-theme';

  const parseTheme = (theme: unknown): Theme =>
    theme === 'dark' || theme === 'light' ? theme : 'auto';

  const loadTheme = () => parseTheme(localStorage.getItem(STORAGE_KEY));

  const systemTheme = () =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  const applyTheme = (theme: Theme) => {
    StarlightThemeProvider.updatePickers(theme);
    document.documentElement.dataset.theme = theme === 'auto' ? systemTheme() : theme;
    localStorage.setItem(STORAGE_KEY, theme === 'auto' ? '' : theme);
  };

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (loadTheme() === 'auto') {
      applyTheme('auto');
    }
  });

  customElements.define(
    'starlight-theme-select',
    class extends HTMLElement {
      constructor() {
        super();
        applyTheme(loadTheme());
        this.querySelector('select')?.addEventListener('change', (event) => {
          applyTheme(parseTheme((event.currentTarget as HTMLSelectElement).value));
        });
      }
    },
  );
</script>

<style>
  /* The tokens preset sizes for a 10px root; Starlight keeps 16px, so match the search bar here. */
  starlight-theme-select :global(select) {
    min-width: 8.5rem;
    height: 2.5rem;
    font-size: var(--sl-text-sm);
  }
</style>
