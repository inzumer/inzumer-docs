---
import { Button, Icon } from '@inzumer/ui-library';
---

<!-- Starlight's mobile menu button with the ui-library Button and icons; the popover does the rest. -->
<div class="menu-button">
  <Button popoverTarget="starlight__sidebar" variant="ghost" size="icon" aria-label="Menú">
    <Icon name="menu" className="open-menu" />
    <Icon name="close" className="close-menu" />
  </Button>
</div>

<style>
  .menu-button {
    position: fixed;
    top: calc((var(--sl-nav-height) - 2.75rem) / 2);
    inset-inline-end: var(--sl-nav-pad-x);
    z-index: var(--sl-z-index-navbar);
  }

  .menu-button :global(button) {
    width: 2.75rem;
    height: 2.75rem;
  }

  .menu-button:has(~ :popover-open) :global(.open-menu),
  .menu-button:not(:has(~ :popover-open)) :global(.close-menu) {
    display: none;
  }

  @media (min-width: 50rem) {
    .menu-button {
      display: none;
    }
  }

  @media print {
    .menu-button {
      display: none;
    }
  }
</style>

<style is:global>
  body:has(#starlight__sidebar:popover-open) {
    overflow: hidden;
  }

  @media (min-width: 50rem) {
    body:has(#starlight__sidebar:popover-open) {
      overflow: auto;
    }
  }
</style>
